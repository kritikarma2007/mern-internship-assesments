<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>Customer Feedback Form</title>

    <style>
        body{
            font-family: Arial, sans-serif;
            background:#ffffff;
            margin:40px;
        }

        .container{
            width:700px;
            margin:auto;
        }

        h2{
            margin-bottom:20px;
        }

        label{
            font-weight:bold;
        }

        .required{
            color:red;
        }

        .name-row{
            display:flex;
            gap:20px;
            margin-top:5px;
        }

        .name-box{
            display:flex;
            flex-direction:column;
        }

        input[type="text"],
        input[type="email"]{
            width:250px;
            padding:8px;
            border:1px solid #ccc;
        }

        .small-text{
            font-size:12px;
            margin-top:3px;
            color:#555;
        }

        .section{
            margin-top:25px;
        }

        .stars{
            color:#d89a5b;
            font-size:28px;
            margin:10px 0;
        }

        .question{
            margin:10px 0;
            font-size:14px;
        }

        table{
            width:100%;
            border-collapse:collapse;
            margin-top:10px;
        }

        th, td{
            border:1px solid #ddd;
            padding:10px;
            text-align:center;
        }

        th:first-child,
        td:first-child{
            text-align:left;
            background:#f2f2f2;
            width:220px;
        }

        button{
            margin-top:25px;
            padding:10px 20px;
            background:#333;
            color:white;
            border:none;
            cursor:pointer;
        }

        button:hover{
            background:#555;
        }
    </style>
</head>

<body>

<div class="container">

    <form>

        <!-- Name -->
        <label>Name <span class="required">*</span></label>

        <div class="name-row">
            <div class="name-box">
                <input type="text" name="firstName">
                <span class="small-text">First</span>
            </div>

            <div class="name-box">
                <input type="text" name="lastName">
                <span class="small-text">Last</span>
            </div>
        </div>

        <!-- Email -->
        <div class="section">
            <label>Email <span class="required">*</span></label><br><br>

            <input type="email" name="email" style="width:565px;">
        </div>

        <!-- Experience -->
        <div class="section">
            <label>Your Experience <span class="required">*</span></label>

            <div class="stars">
                ★ ★ ★ ★ ★
            </div>

            <div class="question">
                Overall, how would you rate your experience with us?
            </div>
        </div>

        <!-- Satisfaction Table -->
        <div class="section">

            <label>How satisfied are you with <span class="required">*</span></label>

            <table>
                <tr>
                    <th></th>
                    <th>Very Unsatisfied</th>
                    <th>Unsatisfied</th>
                    <th>Neutral</th>
                    <th>Satisfied</th>
                    <th>Very Satisfied</th>
                </tr>

                <tr>
                    <td>Purchase</td>

                    <td><input type="radio" name="purchase"></td>
                    <td><input type="radio" name="purchase"></td>
                    <td><input type="radio" name="purchase"></td>
                    <td><input type="radio" name="purchase"></td>
                    <td><input type="radio" name="purchase"></td>
                </tr>

                <tr>
                    <td>Service</td>

                    <td><input type="radio" name="service"></td>
                    <td><input type="radio" name="service"></td>
                    <td><input type="radio" name="service"></td>
                    <td><input type="radio" name="service"></td>
                    <td><input type="radio" name="service"></td>
                </tr>

                <tr>
                    <td>Company Overall</td>

                    <td><input type="radio" name="company"></td>
                    <td><input type="radio" name="company"></td>
                    <td><input type="radio" name="company"></td>
                    <td><input type="radio" name="company"></td>
                    <td><input type="radio" name="company"></td>
                </tr>
            </table>
        </div>

        <!-- Recommendation Table -->
        <div class="section">

            <label>How likely are you to <span class="required">*</span></label>

            <table>
                <tr>
                    <th></th>
                    <th>Very Unlikely</th>
                    <th>Unlikely</th>
                    <th>Neutral</th>
                    <th>Likely</th>
                    <th>Very Likely</th>
                </tr>

                <tr>
                    <td>Buy from us again</td>

                    <td><input type="radio" name="buyAgain"></td>
                    <td><input type="radio" name="buyAgain"></td>
                    <td><input type="radio" name="buyAgain"></td>
                    <td><input type="radio" name="buyAgain"></td>
                    <td><input type="radio" name="buyAgain"></td>
                </tr>

                <tr>
                    <td>Recommend our product to others</td>

                    <td><input type="radio" name="product"></td>
                    <td><input type="radio" name="product"></td>
                    <td><input type="radio" name="product"></td>
                    <td><input type="radio" name="product"></td>
                    <td><input type="radio" name="product"></td>
                </tr>

                <tr>
                    <td>Recommend our company to others</td>

                    <td><input type="radio" name="recommend"></td>
                    <td><input type="radio" name="recommend"></td>
                    <td><input type="radio" name="recommend"></td>
                    <td><input type="radio" name="recommend"></td>
                    <td><input type="radio" name="recommend"></td>
                </tr>
            </table>
        </div>

        <button type="submit">Submit</button>

    </form>

</div>

</body>
</html>