<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>User Personal Information Form</title>

    <style>

        body{
            background:#dcdcdc;
            font-family: Georgia, serif;
        }

        .container{
            width:420px;
            margin:20px auto;
            background:#efefef;
            padding:20px;
            border-radius:10px;
        }

        fieldset{
            border:1px solid black;
            padding:15px;
        }

        legend{
            font-size:18px;
            font-weight:bold;
        }

        label{
            display:block;
            margin-top:15px;
            margin-bottom:8px;
            font-size:16px;
        }

        input[type="text"],
        input[type="email"],
        input[type="password"],
        input[type="date"],
        textarea{
            width:95%;
            padding:10px;
            border:1px solid #bdbdbd;
            border-radius:4px;
            background:#dfe6ef;
            font-size:15px;
        }

        .gender{
            margin-top:10px;
        }

        .gender input{
            margin-left:10px;
        }

        textarea{
            resize:none;
            height:60px;
        }

        button{
            margin-top:20px;
            padding:10px 22px;
            font-size:18px;
            border:2px solid #444;
            border-radius:5px;
            background:white;
            cursor:pointer;
        }

        button:hover{
            background:#d9d9d9;
        }

    </style>

</head>

<body>

    <div class="container">

        <form>

            <fieldset>

                <legend>User personal information</legend>

                <!-- Full Name -->
                <label>Enter your full name</label>
                <input type="text" value="Rahul Kumar">

                <!-- Email -->
                <label>Enter your email</label>
                <input type="email" value="geeks@12345gmail.com">

                <!-- Password -->
                <label>Enter your password</label>
                <input type="password">

                <!-- Confirm Password -->
                <label>Confirm your password</label>
                <input type="password">

                <!-- Gender -->
                <label>Enter your gender</label>

                <div class="gender">
                    <input type="radio" name="gender" checked>Male

                    <input type="radio" name="gender">Female

                    <input type="radio" name="gender">Others
                </div>

                <!-- DOB -->
                <label>Enter your Date of Birth</label>
                <input type="date">

                <!-- Address -->
                <label>Enter your Address:</label>
                <textarea>Noida Sector 137</textarea>

                <!-- Submit -->
                <button type="submit">submit</button>

            </fieldset>

        </form>

    </div>

</body>
</html>